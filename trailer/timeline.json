3","from":0,"to":6.7219999999999995,"at":151.61800000000002},{"file":"audio/handover.mp3","from":6.7219999999999995,"to":18.418999999999997,"at":159.94000000000003}],"captions":[{"t0":5,"t1":6.625,"text":"In the town of Emberhollow,"},{"t0":6.788,"t1":8.808,"text":"third lantern past the fountain,"},{"t0":8.971,"t1":10.074,"text":"there is a bookshop."},{"t0":10.433,"t1":13.162,"text":"It has stood since the Year of the Quiet Comet."},{"t0":14.149,"t1":17.586,"text":"Elves spend decades browsing the Arcana section."},{"t0":17.899,"t1":20.256,"text":"Dwarves weep quietly in Poetry."},{"t0":20.616,"t1":22.834,"text":"Halflings leave crumbs in Cookery,"},{"t0":22.938,"t1":26.119,"text":"and are forgiven, because they bring scones."},{"t0":31.619,"t1":35.032,"text":"For twenty years it has been kept by Mirabel Thistlewick,"},{"t0":35.299,"t1":37.261,"text":"who inherited it from her aunt."},{"t0":38.039,"t1":40.199,"text":"She knows every book on its shelves,"},{"t0":40.292,"t1":42.138,"text":"and every patron by name."},{"t0":43.307,"t1":44.618,"text":"What she does not know,"},{"t0":44.816,"t1":48.845,"text":"most evenings, is whether the shop made any money this month."},{"t0":53.345,"t1":54.854,"text":"The ledger cannot tell her."},{"t0":55.168,"t1":56.782,"text":"Favourite tomes run out."},{"t0":58.013999999999996,"t1":63.076,"text":"A bookwyrm is found asleep in Herbalism after consuming several books for breakfast,"},{"t0":63.272999999999996,"t1":65.40899999999999,"text":"very full, and not at all sorry."},{"t0":66.697,"t1":70.064,"text":"And last week, a signed first edition bit a knight."},{"t0":70.261,"t1":71.01599999999999,"text":"Not a book."},{"t0":71.06299999999999,"t1":71.829,"text":"A mimic."},{"t0":75.102,"t1":79.259,"text":"Pip, the clerk, ran to the tavern to find adventurers to vanquish it."},{"t0":79.688,"t1":81.499,"text":"A price was agreed in haste."},{"t0":81.662,"t1":83.241,"text":"Nobody wrote it down."},{"t0":87.741,"t1":89.668,"text":"Mirabel needed a better system."},{"t0":89.982,"t1":92.013,"text":"The Scribes' Guild offered to help."},{"t0":92.443,"t1":95.009,"text":"A dozen scribes, a year and a day,"},{"t0":95.055,"t1":98.144,"text":"and more gold than the shop takes in a decade."},{"t0":101.944,"t1":104.011,"text":"So Mirabel sent for EPAM."},{"t0":104.498,"t1":106.53,"text":"They did not bring a dozen scribes."},{"t0":106.69200000000001,"t1":108.202,"text":"They brought a small team,"},{"t0":108.32900000000001,"t1":110.64,"text":"and a scriptorium that never sleeps."},{"t0":112.513,"t1":115.63600000000001,"text":"One quill asks the questions she had not thought of."},{"t0":116.12400000000001,"t1":117.58600000000001,"text":"One draws up the plan."},{"t0":117.819,"t1":119.305,"text":"Several write at once."},{"t0":119.50200000000001,"t1":121.406,"text":"One reads every page back."},{"t0":121.60300000000001,"t1":124.309,"text":"And one carries the finished work to the shelf."},{"t0":124.738,"t1":126.52600000000001,"text":"The quills are tireless."},{"t0":126.88600000000001,"t1":129.011,"text":"The judgement is human."},{"t0":133.411,"t1":135.257,"text":"Chapter one is already written."},{"t0":135.524,"t1":137.196,"text":"A shop front for the town."},{"t0":137.358,"t1":139.344,"text":"A counter for Mirabel and Pip."},{"t0":139.541,"t1":141.457,"text":"The catalog, the guest book,"},{"t0":141.654,"t1":142.873,"text":"the incident board."},{"t0":143.361,"t1":144.162,"text":"It works."},{"t0":144.591,"t1":148.318,"text":"And now, Mirabel has a list of what she needs next."},{"t0":151.61800000000002,"t1":152.51200000000003,"text":"At the top of it,"},{"t0":152.54700000000003,"t1":153.78900000000002,"text":"in her own hand:"},{"t0":154.27700000000002,"t1":158.09600000000003,"text":"For a dire incident, I want to post a bounty for adventurers."},{"t0":160.18400000000003,"t1":162.401,"text":"Today, you run the scriptorium,"},{"t0":162.889,"t1":165.08300000000003,"text":"and you need not be an engineer to do it."},{"t0":165.57100000000003,"t1":167.88100000000003,"text":"First, together, the bounty board."},{"t0":168.45000000000002,"t1":171.23700000000002,"text":"After that, Mirabel's list is yours."}],"duration":177.23700000000002}