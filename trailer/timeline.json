1":160.747},{"w":"to","t0":160.816,"t1":160.874},{"w":"do","t0":160.944,"t1":161.06},{"w":"it.","t0":161.165,"t1":161.466},{"w":"First,","t0":161.954,"t1":162.535},{"w":"together,","t0":162.61599999999999,"t1":163.185},{"w":"the","t0":163.254,"t1":163.347},{"w":"bounty","t0":163.417,"t1":163.742},{"w":"board.","t0":163.788,"t1":164.264},{"w":"After","t0":164.833,"t1":165.182},{"w":"that,","t0":165.228,"t1":165.611},{"w":"Mirabel's","t0":165.716,"t1":166.285},{"w":"list","t0":166.35399999999998,"t1":166.586},{"w":"is","t0":166.656,"t1":166.761},{"w":"yours.","t0":166.82999999999998,"t1":167.62}]}},"order":["shop","mirabel","trouble","guild","factory","delivered","handover"],"audio":[{"file":"audio/shop.mp3","from":0,"to":8.417,"at":6},{"file":"audio/shop.mp3","from":8.417,"to":19.904999999999998,"at":14.917},{"file":"audio/mirabel.mp3","from":0,"to":10.954,"at":31.505},{"file":"audio/mirabel.mp3","from":10.954,"to":17.49,"at":43.059},{"file":"audio/trouble.mp3","from":0,"to":9.9905,"at":54.19499999999999},{"file":"audio/trouble.mp3","from":9.9905,"to":14.947500000000002,"at":64.98549999999999},{"file":"audio/trouble.mp3","from":14.947500000000002,"to":23.108999999999998,"at":72.9425},{"file":"audio/guild.mp3","from":0,"to":8.713000000000001,"at":86.204},{"file":"audio/factory.mp3","from":0,"to":9.032499999999999,"at":98.717},{"file":"audio/factory.mp3","from":9.032499999999999,"to":26.267,"at":108.9495},{"file":"audio/delivered.mp3","from":0,"to":13.217,"at":131.084},{"file":"audio/handover.mp3","from":0,"to":6.7219999999999995,"at":147.601},{"file":"audio/handover.mp3","from":6.7219999999999995,"to":18.418999999999997,"at":156.323}],"captions":[{"t0":6,"t1":7.591,"text":"In the town of Emberhollow,"},{"t0":7.753,"t1":9.75,"text":"third lantern past the fountain,"},{"t0":9.947,"t1":11.027000000000001,"text":"there is a bookshop."},{"t0":11.515,"t1":14.173,"text":"It has stood since the Year of the Quiet Comet."},{"t0":15.161,"t1":17.204,"text":"Elves browse it for decades."},{"t0":17.436999999999998,"t1":19.817,"text":"Dwarves weep quietly in Poetry."},{"t0":20.084,"t1":22.336,"text":"Halflings leave crumbs in Cookery,"},{"t0":22.464,"t1":26.005,"text":"and are forgiven, because they bring scones."},{"t0":31.505,"t1":35.336,"text":"For twenty years it has been kept by Mirabel Thistlewick,"},{"t0":35.499,"t1":37.113,"text":"who had it from her aunt."},{"t0":37.682,"t1":39.957,"text":"She knows every book on its shelves,"},{"t0":40.12,"t1":42.07,"text":"and every patron by name."},{"t0":43.44799999999999,"t1":44.666999999999994,"text":"What she does not know,"},{"t0":44.771,"t1":49.19499999999999,"text":"most evenings, is whether the shop made any money this month."},{"t0":54.19499999999999,"t1":55.61099999999999,"text":"The ledger cannot tell her."},{"t0":55.87799999999999,"t1":57.01599999999999,"text":"Favourites run out."},{"t0":57.32999999999999,"t1":59.059999999999995,"text":"The queue runs out of the door."},{"t0":59.32699999999999,"t1":61.916,"text":"A bookwyrm is found asleep in Herbalism,"},{"t0":62.11299999999999,"t1":64.029,"text":"very full, and not at all sorry."},{"t0":65.142,"t1":68.28799999999998,"text":"And last week, a signed first edition bit a knight."},{"t0":68.776,"t1":69.728,"text":"It was a mimic."},{"t0":73.157,"t1":76.51299999999999,"text":"So Pip, the clerk, ran to the tavern to find adventurers,"},{"t0":76.71,"t1":78.77699999999999,"text":"and a price was agreed in a doorway."},{"t0":79.13699999999999,"t1":80.704,"text":"Nobody wrote it down."},{"t0":86.204,"t1":88.317,"text":"The Scribes' Guild offered to help."},{"t0":88.67699999999999,"t1":91.13799999999999,"text":"A dozen scribes, a year and a day,"},{"t0":91.22,"t1":94.517,"text":"and more gold than the shop takes in a decade."},{"t0":98.717,"t1":100.78399999999999,"text":"So Mirabel sent for EPAM."},{"t0":101.271,"t1":103.303,"text":"They did not bring a dozen scribes."},{"t0":103.465,"t1":104.975,"text":"They brought a small team,"},{"t0":105.102,"t1":107.413,"text":"and a scriptorium that never sleeps."},{"t0":109.286,"t1":112.409,"text":"One quill asks the questions she had not thought of."},{"t0":112.897,"t1":114.35900000000001,"text":"One draws up the plan."},{"t0":114.592,"t1":116.078,"text":"Several write at once."},{"t0":116.275,"t1":118.179,"text":"One reads every page back."},{"t0":118.376,"t1":121.082,"text":"And one carries the finished work to the shelf."},{"t0":121.511,"t1":123.299,"text":"The quills are tireless."},{"t0":123.659,"t1":125.784,"text":"The judgement is human."},{"t0":131.084,"t1":132.744,"text":"Chapter one is already written."},{"t0":132.88400000000001,"t1":134.486,"text":"A shop front for the town."},{"t0":134.718,"t1":136.622,"text":"A counter for Mirabel and Pip."},{"t0":137.11,"t1":138.967,"text":"The catalog, the guest book,"},{"t0":139.072,"t1":140.279,"text":"the incident board."},{"t0":140.442,"t1":141.231,"text":"It works."},{"t0":141.498,"t1":143.901,"text":"And now, Mirabel has a list."},{"t0":147.601,"t1":148.495,"text":"At the top of it,"},{"t0":148.53,"t1":149.772,"text":"in her own hand:"},{"t0":150.26,"t1":154.079,"text":"For a dire incident, I want to post a bounty for adventurers."},{"t0":156.567,"t1":158.784,"text":"Today, you run the scriptorium,"},{"t0":159.272,"t1":161.466,"text":"and you need not be an engineer to do it."},{"t0":161.954,"t1":164.264,"text":"First, together, the bounty board."},{"t0":164.833,"t1":167.62,"text":"After that, Mirabel's list is yours."}],"duration":174.62}