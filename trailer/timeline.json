"narrator"},{"w":"A","t0":271.48499999999996,"t1":271.566,"who":"narrator"},{"w":"lending","t0":271.659,"t1":272.01899999999995,"who":"narrator"},{"w":"library.","t0":272.08899999999994,"t1":272.78499999999997,"who":"narrator"},{"w":"A","t0":273.05199999999996,"t1":273.13399999999996,"who":"narrator"},{"w":"second","t0":273.23799999999994,"t1":273.59799999999996,"who":"narrator"},{"w":"clerk.","t0":273.691,"t1":274.24799999999993,"who":"narrator"},{"w":"Choose","t0":275.0799999999999,"t1":275.43999999999994,"who":"narrator"},{"w":"one,","t0":275.48699999999997,"t1":275.765,"who":"narrator"},{"w":"and","t0":275.78899999999993,"t1":275.93999999999994,"who":"narrator"},{"w":"send","t0":276.00899999999996,"t1":276.20699999999994,"who":"narrator"},{"w":"it","t0":276.27599999999995,"t1":276.34599999999995,"who":"narrator"},{"w":"through.","t0":276.381,"t1":277.15899999999993,"who":"narrator"}]}},"order":["shop","pests","mirabel","trouble","guild","factory","delivered","request","chaptertwo"],"audio":[{"file":"audio/shop.mp3","from":0,"to":8.359,"at":5},{"file":"audio/shop.mp3","from":8.359,"to":23.875999999999998,"at":13.859},{"file":"audio/shop.mp3","from":23.875999999999998,"to":36.205,"at":30.676},{"file":"audio/pests.mp3","from":0,"to":2.4029999999999996,"at":47.004999999999995},{"file":"audio/pests.mp3","from":2.4029999999999996,"to":9.979,"at":50.007999999999996},{"file":"audio/pests.mp3","from":9.979,"to":15.888000000000002,"at":58.583999999999996},{"file":"audio/pests.mp3","from":15.888000000000002,"to":18.535,"at":66.093},{"file":"audio/pests.mp3","from":18.535,"to":21.482999999999997,"at":69.53999999999999},{"file":"audio/mirabel.mp3","from":0,"to":12.3295,"at":76.488},{"file":"audio/mirabel.mp3","from":12.3295,"to":18.372,"at":90.0175},{"file":"audio/trouble.mp3","from":0,"to":11.471,"at":99.96},{"file":"audio/trouble.mp3","from":11.471,"to":18.6515,"at":112.831},{"file":"audio/trouble.mp3","from":18.6515,"to":22.593,"at":120.8115},{"file":"audio/trouble.mp3","from":22.593,"to":31.235999999999997,"at":126.353},{"file":"audio/guild.mp3","from":0,"to":14.436499999999999,"at":138.696},{"file":"audio/guild.mp3","from":14.436499999999999,"to":18.279,"at":153.83249999999998},{"file":"audio/factory.mp3","from":0,"to":12.753499999999999,"at":161.67499999999998},{"file":"audio/factory.mp3","from":12.753499999999999,"to":28.727999999999998,"at":176.42849999999999},{"file":"audio/delivered.mp3","from":0,"to":16.84,"at":196.403},{"file":"audio/request-1.mp3","from":0,"to":2.9539999999999997,"at":215.843},{"file":"audio/request-2.mp3","from":0,"to":3.692,"at":219.297},{"file":"audio/request-2.mp3","from":3.692,"to":14.564,"at":223.689},{"file":"audio/request-3.mp3","from":0,"to":5.032500000000001,"at":235.66099999999997},{"file":"audio/request-3.mp3","from":5.032500000000001,"to":7.83,"at":241.29349999999997},{"file":"audio/chaptertwo.mp3","from":0,"to":2.8095,"at":247.39099999999996},{"file":"audio/chaptertwo.mp3","from":2.8095,"to":7.3260000000000005,"at":250.70049999999998},{"file":"audio/chaptertwo.mp3","from":7.3260000000000005,"to":17.485,"at":255.71699999999996},{"file":"audio/chaptertwo.mp3","from":17.485,"to":24.973,"at":266.876},{"file":"audio/chaptertwo.mp3","from":24.973,"to":27.567999999999998,"at":274.96399999999994}],"captions":[{"t0":5,"t1":6.5329999999999995,"text":"In the town of Emberhollow,","who":"narrator"},{"t0":6.66,"t1":8.727,"text":"third lantern past the fountain,","who":"narrator"},{"t0":8.959,"t1":9.992,"text":"there is a bookshop.","who":"narrator"},{"t0":10.422,"t1":13.115,"text":"It has stood since the Year of the Quiet Comet.","who":"narrator"},{"t0":14.103,"t1":16.843,"text":"Every folk in the realm comes through its door.","who":"narrator"},{"t0":17.075,"t1":20.407,"text":"Elves spend decades browsing the Arcana section.","who":"narrator"},{"t0":20.674,"t1":23.135,"text":"Dwarves weep quietly in Poetry.","who":"narrator"},{"t0":23.495,"t1":26.026,"text":"Halflings leave crumbs in Cookery,","who":"narrator"},{"t0":26.154,"t1":28.987,"text":"and are forgiven, because they bring scones.","who":"narrator"},{"t0":31.065,"t1":35.940999999999995,"text":"An orc warband's book club wants fourteen copies of the same romance,","who":"narrator"},{"t0":36.034,"t1":37.205999999999996,"text":"by Thursday.","who":"narrator"},{"t0":37.635999999999996,"t1":39.702999999999996,"text":"The tall shelves have ladders.","who":"narrator"},{"t0":40.016,"t1":42.605,"text":"The low shelves have cushions.","who":"narrator"},{"t0":47.004999999999995,"t1":48.352,"text":"It is also, now and then,","who":"narrator"},{"t0":48.397999999999996,"t1":49.163999999999994,"text":"beset.","who":"narrator"},{"t0":50.251999999999995,"t1":51.97,"text":"Bookwyrms eat the stock.","who":"narrator"},{"t0":52.132999999999996,"t1":54.687,"text":"Poltergeists reshelve by colour.","who":"narrator"},{"t0":55.047,"t1":57.403999999999996,"text":"Ink imps add rude footnotes.","who":"narrator"},{"t0":58.763999999999996,"t1":62.038,"text":"And last week, a signed first edition bit a knight.","who":"narrator"},{"t0":62.607,"t1":63.419,"text":"Not a book.","who":"narrator"},{"t0":63.5,"t1":64.27799999999999,"text":"A mimic.","who":"narrator"},{"t0":66.30799999999999,"t1":68.583,"text":"The knight gave the shop five stars.","who":"narrator"},{"t0":69.697,"t1":72.088,"text":"The mimic now minds the cash box.","who":"narrator"},{"t0":76.488,"t1":79.82,"text":"For twenty years it has been kept by Mirabel Thistlewick,","who":"narrator"},{"t0":80.05199999999999,"t1":81.852,"text":"who inherited it from her aunt,","who":"narrator"},{"t0":81.98,"t1":84,"text":"and who wrote the book on its pests.","who":"narrator"},{"t0":84.487,"t1":86.624,"text":"She knows every tome on its shelves,","who":"narrator"},{"t0":86.751,"t1":88.574,"text":"and every patron by name.","who":"narrator"},{"t0":90.261,"t1":91.515,"text":"What she does not know,","who":"narrator"},{"t0":91.608,"t1":95.66,"text":"most evenings, is whether the shop made any money this month.","who":"narrator"},{"t0":99.96,"t1":101.446,"text":"The ledger cannot tell her.","who":"narrator"},{"t0":101.806,"t1":104.964,"text":"Nor can it say which favourite is about to run out.","who":"narrator"},{"t0":105.452,"t1":109.074,"text":"Or which patron has bought a book every week for nine years.","who":"narrator"},{"t0":109.747,"t1":111.315,"text":"Or what the monsters cost.","who":"narrator"},{"t0":112.947,"t1":116.395,"text":"Then, one evening, the seal on the cellar door went out.","who":"narrator"},{"t0":116.882,"t1":119.878,"text":"Something grey and very old came up the stairs.","who":"narrator"},{"t0":120.945,"t1":121.908,"text":"A dust wraith.","who":"narrator"},{"t0":122.106,"t1":123,"text":"Not a pest.","who":"narrator"},{"t0":123.232,"t1":124.509,"text":"A dire incident.","who":"narrator"},{"t0":126.597,"t1":130.022,"text":"Pip, the clerk, ran to the tavern to find adventurers.","who":"narrator"},{"t0":130.381,"t1":132.344,"text":"A price was agreed in a doorway.","who":"narrator"},{"t0":132.65699999999998,"t1":134.596,"text":"Nobody wrote it down.","who":"narrator"},{"t0":138.696,"t1":140.588,"text":"Mirabel needed a better system,","who":"narrator"},{"t0":140.716,"t1":142.434,"text":"so she asked who could build one.","who":"narrator"},{"t0":143.212,"t1":145.29,"text":"The Scribes' Guild answered first,","who":"narrator"},{"t0":145.418,"t1":146.695,"text":"the way it always has.","who":"narrator"},{"t0":147.125,"t1":148.448,"text":"A dozen scribes.","who":"narrator"},{"t0":148.495,"t1":149.795,"text":"A year and a day.","who":"narrator"},{"t0":150.469,"t1":152.976,"text":"More gold than the shop takes in a decade.","who":"narrator"},{"t0":153.98899999999998,"t1":157.27499999999998,"text":"And every change she asked for would alter the price.","who":"narrator"},{"t0":161.67499999999998,"t1":163.707,"text":"So Mirabel sent for EPAM.","who":"narrator"},{"t0":164.136,"t1":166.21499999999997,"text":"They did not bring a dozen scribes.","who":"narrator"},{"t0":166.44699999999997,"t1":167.82799999999997,"text":"They brought a small team,","who":"narrator"},{"t0":167.921,"t1":170.18499999999997,"text":"and a scriptorium that never sleeps.","who":"narrator"},{"t0":170.754,"t1":172.10099999999997,"text":"Ask on Moonday;","who":"narrator"},{"t0":172.23999999999998,"t1":174.14399999999998,"text":"see it working by Fireday.","who":"narrator"},{"t0":176.713,"t1":179.66199999999998,"text":"One quill asks the questions she had not thought of.","who":"narrator"},{"t0":180.231,"t1":181.73999999999998,"text":"One draws up the plan.","who":"narrator"},{"t0":181.93699999999998,"t1":183.284,"text":"Several write at once.","who":"narrator"},{"t0":183.516,"t1":185.374,"text":"One reads every page back.","who":"narrator"},{"t0":185.53599999999997,"t1":188.09099999999998,"text":"And one carries the finished work to the shelf.","who":"narrator"},{"t0":188.76399999999998,"t1":190.16899999999998,"text":"The quills are tireless.","who":"narrator"},{"t0":190.29699999999997,"t1":192.003,"text":"The judgement is human.","who":"narrator"},{"t0":196.403,"t1":198.261,"text":"Chapter one is already written.","who":"narrator"},{"t0":198.69,"t1":200.362,"text":"A shop front for the town.","who":"narrator"},{"t0":200.72199999999998,"t1":202.742,"text":"A counter for Mirabel and Pip.","who":"narrator"},{"t0":203.009,"t1":204.68099999999998,"text":"A catalog for the tomes,","who":"narrator"},{"t0":204.774,"t1":206.504,"text":"a guest book for the patrons,","who":"narrator"},{"t0":206.864,"t1":208.94199999999998,"text":"an incident board for the monsters.","who":"narrator"},{"t0":209.61499999999998,"t1":210.417,"text":"It works.","who":"narrator"},{"t0":210.498,"t1":212.843,"text":"And now, Mirabel has a list.","who":"narrator"},{"t0":215.843,"t1":216.807,"text":"At the top of it,","who":"narrator"},{"t0":216.934,"t1":218.397,"text":"in her own hand.","who":"narrator"},{"t0":219.297,"t1":222.873,"text":"For a dire incident, I want to post a bounty for adventurers.","who":"mirabel"},{"t0":223.80499999999998,"t1":227.462,"text":"A price, written down before anyone draws a sword.","who":"mirabel"},{"t0":227.81099999999998,"t1":229.807,"text":"The name of whoever takes the job.","who":"mirabel"},{"t0":230.15599999999998,"t1":231.47899999999998,"text":"And what it cost me,","who":"mirabel"},{"t0":231.897,"t1":234.16099999999997,"text":"in my figures at month's end.","who":"mirabel"},{"t0":235.66099999999997,"t1":237.11199999999997,"text":"Who may post a bounty?","who":"narrator"},{"t0":237.30999999999997,"t1":238.41299999999998,"text":"Who may claim one?","who":"narrator"},{"t0":238.72599999999997,"t1":240.40899999999996,"text":"What if two parties do?","who":"narrator"},{"t0":241.57799999999997,"t1":243.69099999999997,"text":"Those pages are not written yet.","who":"narrator"},{"t0":247.39099999999996,"t1":249.95699999999997,"text":"That is chapter two, and you will write it.","who":"narrator"},{"t0":250.94399999999996,"t1":252.68599999999995,"text":"Soon, you run the scriptorium,","who":"narrator"},{"t0":252.76699999999997,"t1":254.97299999999996,"text":"and you need not be an engineer to do it.","who":"narrator"},{"t0":255.96099999999996,"t1":258.236,"text":"First, together, the bounty board:","who":"narrator"},{"t0":258.66599999999994,"t1":261.18499999999995,"text":"you answer the questions, approve the plan,","who":"narrator"},{"t0":261.313,"t1":263.59999999999997,"text":"watch it written, read it back,","who":"narrator"},{"t0":263.64699999999993,"t1":265.539,"text":"and see it on Mirabel's shelf.","who":"narrator"},{"t0":267.21299999999997,"t1":269.38399999999996,"text":"After that, her list is yours.","who":"narrator"},{"t0":269.65099999999995,"t1":271.28799999999995,"text":"Discounts for her regulars.","who":"narrator"},{"t0":271.48499999999996,"t1":272.78499999999997,"text":"A lending library.","who":"narrator"},{"t0":273.05199999999996,"t1":274.24799999999993,"text":"A second clerk.","who":"narrator"},{"t0":275.0799999999999,"t1":277.15899999999993,"text":"Choose one, and send it through.","who":"narrator"}],"duration":283.15899999999993}